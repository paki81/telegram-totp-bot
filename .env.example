# ================== Telegram ==================
# Bot token from @BotFather (/newbot). Use a dedicated bot: a token that already
# has a webhook set by another service cannot be used in polling mode.
BOT_TOKEN=

# Who can use the bot:
#   *              -> anyone (every user gets a separate, private, encrypted vault)
#   123,456        -> only these Telegram user IDs
# Don't know your ID? Message the bot: when not authorized it replies with your ID.
ALLOWED_USERS=*

# Owner user ID: receives the accounts of a legacy single-user store (data/secrets.json)
# during the one-time migration. Optional otherwise.
# OWNER_ID=

# ================== Encryption ==================
# Master key used to derive one encryption key per user vault. Choose ONE:
#   MASTER_KEY=64 hex chars (generate with: openssl rand -hex 32)
#   MASTER_PASSPHRASE=a long passphrase (scrypt + salt stored in data/.salt)
# Losing it means losing every vault. Changing it makes existing vaults unreadable.
MASTER_KEY=

# ================== Behaviour ==================
# Seconds after which messages containing codes are deleted (min 5)
CODE_TTL_SECONDS=30
# Maximum number of accounts per user
# MAX_ACCOUNTS_PER_USER=500
# Data directory (vaults, sessions, passkeys). Default: ./data
# DATA_DIR=./data
# Time zone used in login notifications (default: system time zone)
# DISPLAY_TZ=Europe/Rome

# ================== HTTP server (Mini App + web app + API) ==================
HTTP_PORT=8788
# Bind address. Use 127.0.0.1 if the reverse proxy runs on the same host.
# HTTP_HOST=0.0.0.0

# Public HTTPS URL of the Mini App (Telegram requires HTTPS): put a reverse proxy
# (Caddy, nginx, Nginx Proxy Manager, Traefik...) in front of HTTP_PORT.
# When set, the bot configures the chat menu button and the "Open Mini App" button.
# MINIAPP_URL=https://2fa.example.com

# ================== Browser access (Telegram login / passkeys) ==================
# Public HTTPS origin used for session cookies and as passkey rpID.
# Defaults to the origin of MINIAPP_URL. Changing it invalidates registered passkeys.
# WEB_ORIGIN=https://2fa.example.com
# Web session lifetime: max inactivity (hours) and absolute lifetime (days)
# WEB_SESSION_IDLE_HOURS=12
# WEB_SESSION_MAX_DAYS=7

# ================== Update mode ==================
# polling (default): no public endpoint needed for the bot itself
# webhook: Telegram pushes updates to WEBHOOK_PUBLIC_URL/tg/<WEBHOOK_SECRET>
MODE=polling
# WEBHOOK_SECRET=long-random-path-segment
# WEBHOOK_PUBLIC_URL=https://2fa.example.com
# Optional relay: forward every incoming update to another endpoint (e.g. the
# previous webhook of an existing bot) so that both keep working.
# RELAY_URL=https://example.com/telegram-webhook
